{
  "name": "anyapdf",
  "displayName": "AnyaPDF",
  "description": "Read PDF files in VS Code.",
  "version": "0.2.2",
  "publisher": "Sanyam",
  "repository": {
    "type": "git",
    "url": "https://github.com/snymkmr/anyaPDF.git"
  },
  "icon": "images/anyapdf-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pdf",
    "viewer"
  ],
  "homepage": "https://sanyam.dev",
  "bugs": {
    "url": "https://github.com/snymkmr/anyaPDF/issues"
  },
  "activationEvents": [
    "onCustomEditor:anyapdf.pdfViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "anyapdf.pdfViewer",
        "displayName": "AnyaPDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "anyapdf.zoomIn",
        "title": "AnyaPDF: Zoom In"
      },
      {
        "command": "anyapdf.zoomOut",
        "title": "AnyaPDF: Zoom Out"
      },
      {
        "command": "anyapdf.zoomReset",
        "title": "AnyaPDF: Reset Zoom"
      },
      {
        "command": "anyapdf.fitWidth",
        "title": "AnyaPDF: Fit to Width"
      },
      {
        "command": "anyapdf.goToPage",
        "title": "AnyaPDF: Go to Page"
      },
      {
        "command": "anyapdf.find",
        "title": "AnyaPDF: Find"
      },
      {
        "command": "anyapdf.nextPage",
        "title": "AnyaPDF: Next Page"
      },
      {
        "command": "anyapdf.prevPage",
        "title": "AnyaPDF: Previous Page"
      }
    ],
    "keybindings": [
      {
        "command": "anyapdf.zoomIn",
        "key": "ctrl+=",
        "when": "activeCustomEditorId == 'anyapdf.pdfViewer'"
      },
      {
        "command": "anyapdf.zoomOut",
        "key": "ctrl+-",
        "when": "activeCustomEditorId == 'anyapdf.pdfViewer'"
      },
      {
        "command": "anyapdf.zoomReset",
        "key": "ctrl+0",
        "when": "activeCustomEditorId == 'anyapdf.pdfViewer'"
      },
      {
        "command": "anyapdf.find",
        "key": "ctrl+f",
        "when": "activeCustomEditorId == 'anyapdf.pdfViewer'"
      },
      {
        "command": "anyapdf.nextPage",
        "key": "pagedown",
        "when": "activeCustomEditorId == 'anyapdf.pdfViewer'"
      },
      {
        "command": "anyapdf.prevPage",
        "key": "pageup",
        "when": "activeCustomEditorId == 'anyapdf.pdfViewer'"
      }
    ],
    "configuration": {
      "title": "AnyaPDF",
      "properties": {
        "anyapdf.defaultZoom": {
          "type": "number",
          "default": 100,
          "minimum": 25,
          "maximum": 400,
          "description": "Default PDF zoom percentage."
        },
        "anyapdf.fitToWidthOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Fit PDF pages to the available editor width when opened."
        }
      }
    }
  },
  "scripts": {
    "test": "npm run compile && node --test",
    "compile": "webpack",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package -o dist/",
    "watch": "webpack --watch",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "copy-webpack-plugin": "^12.0.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
