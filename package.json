{
  "name": "anyapdf",
  "displayName": "AnyaPDF",
  "publisher": "Sanyam",
  "version": "0.1.1",
  "description": "Read PDF files in VS Code.",
  "icon": "images/anyapdf-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["pdf", "viewer"],
  "activationEvents": ["onCustomEditor:anypdf.pdfViewer"],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "copy-webpack-plugin": "^12.0.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snymkmr/anyaPDF.git"
  },
  "homepage": "https://sanyam.dev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/snymkmr/anyaPDF/issues"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "anypdf.pdfViewer",
        "displayName": "AnyaPDF Viewer",
        "selector": [{ "filenamePattern": "*.pdf" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "anypdf.zoomIn", "title": "AnyaPDF: Zoom In" },
      { "command": "anypdf.zoomOut", "title": "AnyaPDF: Zoom Out" },
      { "command": "anypdf.zoomReset", "title": "AnyaPDF: Reset Zoom" },
      { "command": "anypdf.fitWidth", "title": "AnyaPDF: Fit to Width" },
      { "command": "anypdf.goToPage", "title": "AnyaPDF: Go to Page" },
      { "command": "anypdf.find", "title": "AnyaPDF: Find" },
      { "command": "anypdf.nextPage", "title": "AnyaPDF: Next Page" },
      { "command": "anypdf.prevPage", "title": "AnyaPDF: Previous Page" }
    ],
    "keybindings": [
      { "command": "anypdf.zoomIn", "key": "ctrl+=", "when": "activeCustomEditorId == 'anypdf.pdfViewer'" },
      { "command": "anypdf.zoomOut", "key": "ctrl+-", "when": "activeCustomEditorId == 'anypdf.pdfViewer'" },
      { "command": "anypdf.zoomReset", "key": "ctrl+0", "when": "activeCustomEditorId == 'anypdf.pdfViewer'" },
      { "command": "anypdf.find", "key": "ctrl+f", "when": "activeCustomEditorId == 'anypdf.pdfViewer'" },
      { "command": "anypdf.nextPage", "key": "pagedown", "when": "activeCustomEditorId == 'anypdf.pdfViewer'" },
      { "command": "anypdf.prevPage", "key": "pageup", "when": "activeCustomEditorId == 'anypdf.pdfViewer'" }
    ],
    "configuration": {
      "title": "AnyaPDF",
      "properties": {
        "anypdf.defaultZoom": {
          "type": "number",
          "default": 100,
          "minimum": 25,
          "maximum": 400,
          "description": "Default PDF zoom percentage."
        },
        "anypdf.fitToWidthOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Fit PDF pages to the available editor width when opened."
        }
      }
    }
  }
}
